<div id="bench-scroller" style="height: 600px; overflow: auto; position: relative;">
  {{#if this.isLight}}
    <VerticalCollection
      @items={{this.items}}
      @key="id"
      @estimateHeight={{40}}
      @staticHeight={{true}}
      @bufferSize={{5}}
      @shouldRecycle={{this.shouldRecycle}}
      as |item|
    >
      <div class="bench-row" data-id={{item.id}} style="height: 40px;">{{item.title}} {{item.date}}</div>
    </VerticalCollection>
  {{else if this.isMedium}}
    <VerticalCollection
      @items={{this.items}}
      @key="id"
      @estimateHeight={{60}}
      @bufferSize={{5}}
      @shouldRecycle={{this.shouldRecycle}}
      as |item|
    >
      <article class="bench-row" data-id={{item.id}}>
        <header><strong>{{item.title}}</strong> <time>{{item.date}}</time></header>
        {{#if item.note}}<p>{{item.note}}</p>{{/if}}
        <ul>
          {{#each item.tags as |tag|}}
            <li>{{tag}}</li>
          {{/each}}
        </ul>
        <button type="button">Open {{item.id}}</button>
      </article>
    </VerticalCollection>
  {{else}}
    <VerticalCollection
      @items={{this.items}}
      @key="id"
      @estimateHeight={{44}}
      @staticHeight={{true}}
      @bufferSize={{10}}
      @shouldRecycle={{this.shouldRecycle}}
      as |item|
    >
      <div class="bench-row" data-id={{item.id}} style="height: 44px; display: flex; gap: 8px; overflow: hidden; white-space: nowrap;">
        <strong>{{item.title}}</strong>
        {{#each item.values as |value|}}
          <BenchCell @value={{value}} />
        {{/each}}
        {{#each item.seriesList as |points|}}
          <BenchSparkline @points={{points}} />
        {{/each}}
      </div>
    </VerticalCollection>
  {{/if}}
</div>
