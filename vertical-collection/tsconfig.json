/**
 * This tsconfig is not used for publishing.
 * It's only for the local editing experience
 * (and linting)
 */
{
  "extends": "@ember/app-tsconfig",
  "include": ["src/**/*", "unpublished-development-types/**/*"],
  "compilerOptions": {
    "allowJs": true,
    "rootDir": ".",
    "types": ["ember-source/types", "@glint/ember-tsc/types"]
  }
}
