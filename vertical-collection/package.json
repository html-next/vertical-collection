{
  "name": "@html-next/vertical-collection",
  "version": "6.0.0",
  "description": "infinite-scroll, done right. done.",
  "keywords": [
    "occlusion",
    "infinite",
    "infinite-scroll",
    "collection",
    "grid",
    "list-view",
    "recycling",
    "cloaking",
    "performance",
    "lists",
    "ember-addon"
  ],
  "homepage": "https://github.com/html-next/vertical-collection",
  "bugs": "https://github.com/html-next/vertical-collection/issues",
  "repository": "https://github.com/html-next/vertical-collection.git",
  "license": "MIT",
  "author": {
    "name": "Chris Thoburn (@runspired)",
    "url": "https://runspired.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./-private/index": {
      "types": "./dist/-private/index.d.ts",
      "default": "./dist/-private/index.js"
    }
  },
  "contributors": [
    {
      "name": "Chris Garrett (@pzuraq)",
      "email": "me@pzuraq.com",
      "url": "https://github.com/pzuraq"
    },
    {
      "name": "Robert Wagner (@rwwagner90)",
      "email": "rwwagner90@gmail.com",
      "url": "https://github.com/rwwagner90"
    }
  ],
  "files": [
    "addon-main.cjs",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "concurrently \"pnpm:lint:css -- --fix\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" && pnpm run format",
    "lint:format": "prettier . --cache --check",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "ember-tsc --noEmit"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.10.2",
    "decorator-transforms": "^2.3.0",
    "ember-raf-scheduler": "~0.5.1",
    "tracked-built-ins": "^4.1.2"
  },
  "peerDependencies": {
    "@glimmer/component": "^1.1.2 || ^2.0.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.22.10",
    "@babel/plugin-transform-typescript": "^7.28.6",
    "@ember/app-tsconfig": "^1.0.3",
    "@ember/library-tsconfig": "^1.1.3",
    "@ember/test-waiters": "~3.1.0",
    "@eslint/js": "^9.39.2",
    "@glimmer/component": "^2.1.1",
    "@glint/ember-tsc": "^1.14.3",
    "@glint/template": "^1.11.1",
    "@nullvoxpopuli/ember-rolldown": "^2.13.0",
    "@tsdown/css": "^0.23.5",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "concurrently": "^8.2.0",
    "ember-inflector": "^6.0.0",
    "ember-perf-timeline": "^2.0.0",
    "ember-qunit": "^7.0.0",
    "ember-source": "~5.2.0",
    "ember-template-lint": "^5.11.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^12.7.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.23.2",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-qunit": "^8.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.0.2",
    "prettier-plugin-ember-template-tag": "^2.0.6",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-prettier": "^5.0.3",
    "tsdown": "^0.23.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1"
  },
  "engines": {
    "node": ">= 18"
  },
  "volta": {
    "extends": "../package.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "app-js": {}
  }
}
